# ---------- Supabase (Project Settings -> API) ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # "anon public" key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SECRET - only used by jobs/sync_movies.py, never by the web app

# ---------- TMDB (themoviedb.org -> Settings -> API) ----------
TMDB_API_KEY=                        # v3 API key OR the v4 "Read Access Token"

# ---------- LLM (free: Groq) ----------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile    # check console.groq.com for currently available free models
LLM_API_KEY=gsk_...
LLM_TEMPERATURE=0.2

# ---------- App ----------
HISTORY_MESSAGES=6                   # recent messages sent to the LLM (short-term memory)
EMBEDDINGS_ENABLED=false             # true only after: pip install fastembed + python -m jobs.sync_movies --embed
PORT=5000
